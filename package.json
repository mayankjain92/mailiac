{
  "name": "mailiac",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=20",
    "build": "turbo run build",
    "clean": "rm -rf .turbo apps/*/.turbo apps/*/.next apps/*/dist packages/*/.turbo packages/*/dist packages/*/*/.turbo packages/*/*/dist dist",
    "rebuild": "pnpm clean && pnpm build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "start:all": "node apps/worker/dist/index.js & node apps/api/dist/server.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
