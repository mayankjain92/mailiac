    {
      "id": "p1_under_hood_text",
      "type": "text",
      "x": 110,
      "y": 215,
      "width": 310,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
