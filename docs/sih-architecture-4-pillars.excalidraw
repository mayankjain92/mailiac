      ],
      "frameId": null,
      "roundness": null,
      "seed": 60035,
      "version": 1,
      "versionNonce": 60036,
      "isDeleted": false,
      "text": "PILLAR 2: SENDER IDENTITY (25%)\n==============================\n\u26a1 STEP 3: Reverse-Hop Trace\n   (@mailiac/scoring-reverse-hop)\n\nUnder the hood:\n\u2022 Reverse-Hop: Trace Received headers\n\u2022 PTR Check: Validate DNS Host Claim\n\u2022 Edit Distance: Levenshtein Score\n\u2022 Homoglyph: Detect Cyrillic Spoofing\n==============================\nOutput: identityScore (0 - 100)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "p2_under_hood",
      "originalText": "PILLAR 2: SENDER IDENTITY (25%)\n==============================\n\u26a1 STEP 3: Reverse-Hop Trace\n   (@mailiac/scoring-reverse-hop)\n\nUnder the hood:\n\u2022 Reverse-Hop: Trace Received headers\n\u2022 PTR Check: Validate DNS Host Claim\n\u2022 Edit Distance: Levenshtein Score\n\u2022 Homoglyph: Detect Cyrillic Spoofing\n==============================\nOutput: identityScore (0 - 100)",
      "lineHeight": 1.25
    },
